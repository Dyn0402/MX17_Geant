# W2 combine stage — ONE job, run after all 66 family slabs are on EOS.
# Runs at CERN rather than on the laptop because /eos/experiment redirects to
# eosexperiment.cern.ch, which does not resolve off-site (see run_w2_combine.sh).
universe                = vanilla
executable              = /afs/cern.ch/work/d/dneff/mx17_s1/run_w2_combine.sh
output                  = /afs/cern.ch/work/d/dneff/mx17_s1/logs/w2_combine.out
error                   = /afs/cern.ch/work/d/dneff/mx17_s1/logs/w2_combine.err
log                     = /afs/cern.ch/work/d/dneff/mx17_s1/logs/w2.log
request_cpus            = 4
request_memory          = 20000
request_disk            = 45000000
+JobFlavour             = "workday"
MY.SendCredential       = true
environment             = "OMP_NUM_THREADS=4"
queue
