# Decisive test of WHY the LUT caching cert reads 1.87 % instead of the plan's
# 1e-4. Both products tested so far are ny=1024 members of s1_ny1024/, and
# commit e36a39c (2026-08-08 14:00, AFTER the 08-07 certification) gives an
# ny=1024 product y_stride=2 while an ny=512 product keeps y_stride=1.
# So: run the identical cert on an ny=512 product from the OLD s1/ grid.
#   Y back to ~1e-4  -> the 1.87 % is the ny=1024 y-decimation in e36a39c
#   Y still 1.87 %   -> product- AND grid-independent, i.e. time resampling
# This matters tonight because the W2 products are ny=512 -> stride 1, so a
# near-1e-4 W2 result must NOT be read as "W2 fixed the fast path".
# (s1/ sharing metadata is pre-Fix-2 and mislabelled, but the G arrays this
# cert reads are fine.)
universe                = vanilla
executable              = /afs/cern.ch/work/d/dneff/mx17_s1/run_w2_cert.sh
arguments               = "W1_ny512_dk75um_rho2M /eos/experiment/ntof/data/x17/response_sim/s1 greens_comb_rho2M_dk75um.npz"
output                  = /afs/cern.ch/work/d/dneff/mx17_s1/logs/w2_cert_ny512.out
error                   = /afs/cern.ch/work/d/dneff/mx17_s1/logs/w2_cert_ny512.err
log                     = /afs/cern.ch/work/d/dneff/mx17_s1/logs/w2.log
request_cpus            = 4
request_memory          = 16000
request_disk            = 12000000
+JobFlavour             = "workday"
MY.SendCredential       = true
environment             = "OMP_NUM_THREADS=4"
queue
