# W2 fast REPRESENTATIVE smoke job: Y-box family 0 at ny=256 (N=12,480 —
# same 64-family Bloch structure, same code path end to end including the
# credentialed xrdcp to EOS, ~8x less eigh work). Output -> slabs_mini/,
# never mistaken for production.
universe                = vanilla
executable              = /afs/cern.ch/work/d/dneff/mx17_s1/run_w2_family.sh
arguments               = y 0 256
output                  = /afs/cern.ch/work/d/dneff/mx17_s1/logs/w2_mini.out
error                   = /afs/cern.ch/work/d/dneff/mx17_s1/logs/w2_mini.err
log                     = /afs/cern.ch/work/d/dneff/mx17_s1/logs/w2.log
request_cpus            = 4
request_memory          = 8000
request_disk            = 4000000
+JobFlavour             = "longlunch"
MY.SendCredential       = true
environment             = "OMP_NUM_THREADS=4"
queue
