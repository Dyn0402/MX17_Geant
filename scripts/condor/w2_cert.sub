# W2 recertification: fast-path caching cert + T10 slow-path verdict.
# rho2M reproduces the W1 T10 baseline exactly (only the boundary model
# changes); rho1M is the digitizer's nominal production point, carried as the
# rho sensitivity. Submit only after w2_combine has written the products.
universe                = vanilla
executable              = /afs/cern.ch/work/d/dneff/mx17_s1/run_w2_cert.sh
arguments               = $(rhotag)
output                  = /afs/cern.ch/work/d/dneff/mx17_s1/logs/w2_cert_$(rhotag).out
error                   = /afs/cern.ch/work/d/dneff/mx17_s1/logs/w2_cert_$(rhotag).err
log                     = /afs/cern.ch/work/d/dneff/mx17_s1/logs/w2.log
request_cpus            = 4
request_memory          = 16000
request_disk            = 12000000
+JobFlavour             = "workday"
MY.SendCredential       = true
environment             = "OMP_NUM_THREADS=4"
queue rhotag from (
rho2M
rho1M
)
