# Duplicate of the y000 family job, raced against the original canary
# (13353071.0) rather than replacing it. The original's RemoteUserCpu has been
# frozen at 24105.0 across two 8-min sampler ticks while wall time climbs,
# which is the stuck signature for a running dsyevd — but it may equally be
# minutes from finishing, and combine needs y000. A duplicate costs one slot
# for ~1 h and cannot lose: same code, same inputs, so whichever finishes first
# writes a correct slab and the other's upload is idempotent.
universe                = vanilla
executable              = /afs/cern.ch/work/d/dneff/mx17_s1/run_w2_family.sh
arguments               = y 0
output                  = /afs/cern.ch/work/d/dneff/mx17_s1/logs/w2_y000_redo.out
error                   = /afs/cern.ch/work/d/dneff/mx17_s1/logs/w2_y000_redo.err
log                     = /afs/cern.ch/work/d/dneff/mx17_s1/logs/w2.log
request_cpus            = 4
request_memory          = 30000
request_disk            = 8000000
+JobFlavour             = "tomorrow"
MY.SendCredential       = true
environment             = "OMP_NUM_THREADS=4"
queue
