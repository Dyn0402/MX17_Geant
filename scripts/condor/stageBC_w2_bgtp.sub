arguments               = "rho2M bgtp$(tag)_$(ang) /afs/cern.ch/work/d/dneff/mx17_s1/calib/noise_det3_satscan_feu07.json /afs/cern.ch/work/d/dneff/mx17_s1/clusters_ang/mx17_muons_3k_ang_$(ang)_t0.root '--ion-speed-scale $(s) --feedback-bg $(bg) --shaper-tp-ns 166'"
