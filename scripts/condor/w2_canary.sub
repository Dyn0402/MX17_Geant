# W2 grid re-solve — CANARY pair (one family per box). Check their logs and
# slabs before releasing w2_rest.sub. Pattern follows s1_ny1024.sub; see
# README.md for the SendCredential / thread-pinning / ssh-alias traps.
universe                = vanilla
executable              = /afs/cern.ch/work/d/dneff/mx17_s1/run_w2_family.sh
arguments               = $(box) $(fam)
output                  = /afs/cern.ch/work/d/dneff/mx17_s1/logs/w2_$(box)$(fam).out
error                   = /afs/cern.ch/work/d/dneff/mx17_s1/logs/w2_$(box)$(fam).err
log                     = /afs/cern.ch/work/d/dneff/mx17_s1/logs/w2.log
request_cpus            = 4
request_memory          = 30000
request_disk            = 8000000
+JobFlavour             = "tomorrow"
MY.SendCredential       = true
environment             = "OMP_NUM_THREADS=4"
queue box, fam from (
y, 0
x, 0
)
